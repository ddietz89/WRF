--- a/dyn_em/module_small_step_em.F
+++ b/dyn_em/module_small_step_em.F
@@ -921,6 +921,9 @@
 !    since we want tendency to fit ADT eqn 44 (coupled) we need to
 !    multiply by (mx/my):
      DO k = k_start, k_end
+#ifdef WRF_SMALL_STEP_U_NH_CORRECTION_SIMD
+!$OMP SIMD
+#endif
        DO i = i_start_up, i_end_up
          dpxy(i,k)=dpxy(i,k) + (qrow(i))*rdx*(php(i,k,j)-php(i-1,k,j))*        &
            (rdnw(k)*(dpn(i,k+1)-dpn(i,k))-.5*((c1h(k)*mu(i-1,j))+(c1h(k)*mu(i,j))))
--- a/dyn_em/Makefile
+++ b/dyn_em/Makefile
@@ -151,6 +151,22 @@
 endif
 endif
 endif
+# U nonhydrostatic pressure correction SIMD: qualified GNU13.3 SmallStep path.
+# Use WRF_SMALL_STEP_U_NH_CORRECTION_SIMD=0 and rebuild to omit this directive.
+WRF_SMALL_STEP_U_NH_CORRECTION_SIMD ?= 1
+ifeq ($(WRF_SMALL_STEP_U_NH_CORRECTION_SIMD),1)
+ifeq ($(WRF_SMALL_STEP_SIMD),1)
+ifeq ($(WRF_SMALL_STEP_ZEN2),1)
+ifeq ($(strip $(OMPCPP)),)
+ifneq (,$(findstring GNU Fortran,$(shell $(SFC) --version 2>/dev/null)))
+ifneq (,$(findstring 13.3.0,$(shell $(SFC) --version 2>/dev/null)))
+module_small_step_em.o: private override CPPFLAGS += -DWRF_SMALL_STEP_U_NH_CORRECTION_SIMD
+endif
+endif
+endif
+endif
+endif
+endif
 
 cio.o :
 	$(CC) -c $(CFLAGS) cio.c
