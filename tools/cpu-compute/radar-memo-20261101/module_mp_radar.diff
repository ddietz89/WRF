+      DOUBLE PRECISION:: vol1, vol2
+      COMPLEX*16:: mtmp
+      INTEGER:: error
+
+      cumulerror = 0
+      mix_nested_air_water_icewater = CMPLX(1.0d0,0.0d0)
+      vol1 = volice / MAX(volice+volwater,1d-10)
