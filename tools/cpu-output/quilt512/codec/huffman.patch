+#  if BYTE_ORDER == LITTLE_ENDIAN && CHAR_BIT == 8
+/* Snapshot exactly the two initialized uint16_t fields on this layout. */
+static inline uint32_t zng_emit_code_len_snapshot(const ct_data *entry) {
+    if (sizeof(ct_data) == 4 && offsetof(ct_data, Code) == 0 &&
+        offsetof(ct_data, Len) == 2) {
+        uint32_t pair;
+        memcpy(&pair, entry, sizeof(pair));
+        return pair;
+    }
+    return (uint32_t)entry->Code | ((uint32_t)entry->Len << 16);
+}
+#  endif
