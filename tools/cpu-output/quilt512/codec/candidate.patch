+static inline Pos deflate_fast_quick_insert_string(deflate_state *const s, uint32_t str) {
+    uint8_t *strstart = s->window + str;
+    uint32_t val;
+    uint32_t hm;
+    Pos head;
+
+#if BYTE_ORDER == LITTLE_ENDIAN
+    val = zng_memread_4(strstart);
+#else
+    val = ZSWAP32(zng_memread_4(strstart));
+#endif
+    hm = ((val * 2654435761U) >> 16);
+    hm &= HASH_MASK;
+
+    head = s->head[hm];
+    if (LIKELY(head != str)) {
+        s->prev[str & s->w_mask] = head;
+        s->head[hm] = (Pos)str;
+    }
+    return head;
+}
 
