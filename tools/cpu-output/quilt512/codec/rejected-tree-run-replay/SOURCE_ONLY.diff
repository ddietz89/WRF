+/* Per-flush automatic descriptors; no deflate_state or public ABI change. */
+typedef struct {
+    uint8_t symbol;
+    uint8_t extra_value;
+    uint8_t extra_bits;
+} tree_run_token;
+#define TREE_RUN_CAPACITY (L_CODES + D_CODES)
+
+static inline void tree_run_push(tree_run_token *tokens, unsigned *used,
+                                 unsigned symbol, unsigned value, unsigned bits) {
+    Assert(*used < TREE_RUN_CAPACITY, "tree run descriptor overflow");
+    tokens[*used].symbol = (uint8_t)symbol;
+    tokens[*used].extra_value = (uint8_t)value;
+    tokens[*used].extra_bits = (uint8_t)bits;
+    ++*used;
+}
