+static void
+H5Z__unshuffle4_sse2(const unsigned char *src, unsigned char *dst, size_t nbytes)
+{
+    size_t N;
+    size_t i;
+    const unsigned char *p0;
+    const unsigned char *p1;
+    const unsigned char *p2;
+    const unsigned char *p3;
+    unsigned char *d;
+
+    if (nbytes < 8) {
+        if (nbytes)
+            memcpy(dst, src, nbytes);
+        return;
+    }
+
+    N = nbytes / 4;
+    p0 = src;
+    p1 = src + N;
+    p2 = src + 2 * N;
+    p3 = src + 3 * N;
+    d  = dst;
+
+    i = 0;
+    for (; i + 16 <= N; i += 16) {
+        __m128i a0 = _mm_loadu_si128((const __m128i *)(const void *)(p0 + i));
+        __m128i a1 = _mm_loadu_si128((const __m128i *)(const void *)(p1 + i));
+        __m128i a2 = _mm_loadu_si128((const __m128i *)(const void *)(p2 + i));
+        __m128i a3 = _mm_loadu_si128((const __m128i *)(const void *)(p3 + i));
+
+        __m128i l01 = _mm_unpacklo_epi8(a0, a1);
+        __m128i h01 = _mm_unpackhi_epi8(a0, a1);
+        __m128i l23 = _mm_unpacklo_epi8(a2, a3);
+        __m128i h23 = _mm_unpackhi_epi8(a2, a3);
+
+        __m128i e0 = _mm_unpacklo_epi16(l01, l23);
+        __m128i e1 = _mm_unpackhi_epi16(l01, l23);
+        __m128i e2 = _mm_unpacklo_epi16(h01, h23);
+        __m128i e3 = _mm_unpackhi_epi16(h01, h23);
+
+        _mm_storeu_si128((__m128i *)(void *)(d + 0),  e0);
+        _mm_storeu_si128((__m128i *)(void *)(d + 16), e1);
+        _mm_storeu_si128((__m128i *)(void *)(d + 32), e2);
+        _mm_storeu_si128((__m128i *)(void *)(d + 48), e3);
+        d += 64;
+    }
+
+    for (; i < N; i++) {
+        size_t o = 4 * i;
+        dst[o + 0] = p0[i];
+        dst[o + 1] = p1[i];
+        dst[o + 2] = p2[i];
+        dst[o + 3] = p3[i];
+    }
+
+    H5Z__unshuffle4_copy_tail(src + 4 * N, dst + 4 * N, nbytes - 4 * N);
+}
