+/* Called only after all ordinary NC validation/selection/xfer setup. The
+ * callback owns no dataset ID, must join before return, and must leave out
+ * untouched on any non-1 result. No worker may call NC/HDF5/MPI.
+ *
+ * Exact pinned HDF5 1.14.3 H5E.c evidence: get_current_stack copies entries AND
+ * handler then empties default entries; set_current_stack consumes its ID and
+ * copies entries but DOES NOT restore the handler. get/set_auto2 DEFAULT do
+ * not clear entries. close_stack DOES clear default entries. Consequently
+ * stack installation is the LAST HDF5 bookkeeping call on each return path.
+ * Main-thread fenv/errno are restored after HDF bookkeeping, never after the
+ * subsequent original H5Dread. Failure to restore is fatal, not NC success. */
+/* Experimental admission only; NEVER raise, clear, or normalize exceptions.
+ * PENDING exact native HDF825 cause proof: the bypassed native owner operation
+ * must be shown to contribute SSE inexact only for this fixed metadata route.
+ * An x87-only sticky inexact does not satisfy the SSE MXCSR predicate.
+ * All SSE and x87 exceptions must already be masked, so no trapping state is
+ * bypassed. Unsupported architecture/state retains ordinary H5Dread. */
+static int
+nc_pd_fp_admissible(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    unsigned int csr = _mm_getcsr();
+    unsigned short cw;
+    __asm__ volatile("fnstcw %0" : "=m" (cw));
+    return (csr & (1u << 5)) != 0 &&
+           (csr & (0x3fu << 7)) == (0x3fu << 7) &&
+           (cw & 0x3fu) == 0x3fu;
+#else
+    return 0;
+#endif
+}
+
+static int
+nc_pd_try(hid_t dataset, void *out, size_t nbytes)
+{
+    int entry_errno = errno, post_errno, supplied;
+    fenv_t entry_env, post_env;
+    hid_t entry_stack, post_stack;
+    H5E_auto2_t handler;
+    void *handler_data;
+
+    if (fegetenv(&entry_env) != 0)
+        abort();
+    entry_stack = H5Eget_current_stack();
+    if (entry_stack < 0 ||
+        H5Eget_auto2(H5E_DEFAULT, &handler, &handler_data) < 0 ||
+        H5Eset_auto2(H5E_DEFAULT, NULL, NULL) < 0)
+        abort();
+    atomic_store(&nc_pd_scope.busy, 1);
+    if (fesetenv(&entry_env) != 0)
+        abort();
+    errno = entry_errno;
+    supplied = nc_pd_scope.provider((int64_t)dataset, out, nbytes, nc_pd_scope.user);
+    post_errno = errno;
+    if (fegetenv(&post_env) != 0)
+        abort();
+    if (supplied == 1) {
+        /* Preserve callback POST state while disposing the unused entry copy.
+         * No entry-state restoration on the accepted path. */
+        post_stack = H5Eget_current_stack();
+        if (post_stack < 0 || H5Eclose_stack(entry_stack) < 0 ||
+            H5Eset_auto2(H5E_DEFAULT, handler, handler_data) < 0 ||
+            H5Eset_current_stack(post_stack) < 0)
+            abort();
+        if (fesetenv(&post_env) != 0)
+            abort();
+        errno = post_errno;
+    } else {
+        /* Consume entry copy exactly once, restore PRIVATE attempt only;
+         * ordinary H5Dread and the original NC cleanup remain authoritative. */
+        if (H5Eset_auto2(H5E_DEFAULT, handler, handler_data) < 0 ||
+            H5Eset_current_stack(entry_stack) < 0)
+            abort();
+        if (fesetenv(&entry_env) != 0)
+            abort();
+        errno = entry_errno;
+    }
+    atomic_store(&nc_pd_scope.busy, 0);
+    return supplied == 1;
 }
 
