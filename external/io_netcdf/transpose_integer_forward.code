  ix=0
  jx=0
  kx=0
  call reorder(MemoryOrder,MemO)
  if(IACHAR(MemO(1:1)) > MaxUpperCase) ix=i2+i1
  if(IACHAR(MemO(2:2)) > MaxUpperCase) jx=j2+j1
  if(IACHAR(MemO(3:3)) > MaxUpperCase) kx=k2+k1

! pjj/cray
  if(IO == 'write') then
  if(di == 1) then
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      if(i1<=i2)then
        if(i1>=ix)then
          do i=i1,i2
              DFIELD1 = Field(1,i-ix,abs(jx-j),abs(kx-k))
          enddo
        else
          do i=i1,i2
              DFIELD1 = Field(1,abs(ix-i),abs(jx-j),abs(kx-k))
          enddo
        endif
      else
        do i=i1,i2
            DFIELD1 = Field(1,abs(ix-i),abs(jx-j),abs(kx-k))
        enddo
      endif
    enddo
  enddo
!$OMP END PARALLEL DO
  else if(di == 2) then
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      do i=i1,i2
          DFIELD1 = Field(1,abs(ix-i),abs(jx-j),abs(kx-k))
          DFIELD2 = Field(2,abs(ix-i),abs(jx-j),abs(kx-k))
      enddo
    enddo
  enddo
!$OMP END PARALLEL DO
  else
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      do i=i1,i2
          DFIELD = Field(1:di,abs(ix-i),abs(jx-j),abs(kx-k))
      enddo
    enddo
  enddo
!$OMP END PARALLEL DO
  endif
else
  if(di == 1) then
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      do i=i1,i2
          Field(1,abs(ix-i),abs(jx-j),abs(kx-k)) = DFIELD1
      enddo
    enddo
  enddo
!$OMP END PARALLEL DO
  else if(di == 2) then
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      do i=i1,i2
          Field(1,abs(ix-i),abs(jx-j),abs(kx-k)) = DFIELD1
          Field(2,abs(ix-i),abs(jx-j),abs(kx-k)) = DFIELD2
      enddo
    enddo
  enddo
!$OMP END PARALLEL DO
  else
!dir$ concurrent
!$OMP PARALLEL DO SCHEDULE(RUNTIME) PRIVATE(i,j,k)
  do k=k1,k2
    do j=j1,j2
!dir$ prefervector
!dir$ concurrent
!cdir select(vector)
      do i=i1,i2
          Field(1:di,abs(ix-i),abs(jx-j),abs(kx-k)) = DFIELD
      enddo
    enddo
  enddo
!$OMP END PARALLEL DO
  endif
endif

  return
